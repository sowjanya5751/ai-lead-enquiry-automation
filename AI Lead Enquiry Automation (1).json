    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst ai = $json.output;\n\nconst allowedCategories = [\n  'Pricing',\n  'Service Inquiry',\n  'Consultation Request',\n  'Booking or Availability',\n  'Technical Support',\n  'Complaint',\n  'Other',\n];\n\nconst allowedPriorities = ['Low', 'Medium', 'High'];\nconst errors = [];\n\nif (!ai || typeof ai !== 'object' || Array.isArray(ai)) {\n  errors.push('AI output is missing or is not an object.');\n} else {\n  if (!allowedCategories.includes(ai.category)) {\n    errors.push('Invalid category');\n  }\n\n  if (!allowedPriorities.includes(ai.priority)) {\n    errors.push('Invalid priority');\n  }\n\n  if (\n    typeof ai.priority_reason !== 'string' ||\n    !ai.priority_reason.trim() ||\n    ai.priority_reason.length > 1000\n  ) {\n    errors.push('Invalid priority_reason');\n  }\n\n  if (\n    !Array.isArray(ai.missing_information) ||\n    !ai.missing_information.every(\n      item => typeof item === 'string' && item.trim().length > 0\n    ) ||\n    ai.missing_information.length > 20\n  ) {\n    errors.push('Invalid missing_information');\n  }\n\n  if (\n    typeof ai.reply_draft !== 'string' ||\n    !ai.reply_draft.trim() ||\n    ai.reply_draft.length > 3000\n  ) {\n    errors.push('Invalid reply_draft');\n  }\n\n  if (typeof ai.needs_human_review !== 'boolean') {\n    errors.push('Invalid needs_human_review');\n  }\n}\n\nreturn {\n  ...$json,\n  ai_validation_passed: errors.length === 0,\n  ai_validation_errors: errors,\n};\n"
      },
